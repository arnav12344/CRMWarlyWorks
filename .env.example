# SQLite database (embedded, zero external service)
DATABASE_URL="file:./dev.db"

# 32-byte key (hex or base64) used to encrypt provider API keys at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="replace-with-a-32-byte-hex-or-base64-key"
