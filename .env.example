# ---------------------------------------------------------------------------
# Database — Supabase Postgres (Project Settings → Database → Connect)
# ---------------------------------------------------------------------------
# Runtime: Supavisor TRANSACTION pooler (port 6543). Keep the two params.
# For local dev add &schema=dev so dev data never touches production (public).
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=dev"
# Migrations: SESSION pooler / direct connection (port 5432). Same schema param.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres?schema=dev"

# 32-byte key used to encrypt verifier API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="replace-with-64-hex-chars"

# ---------------------------------------------------------------------------
# Email — Gmail SMTP (send) + IMAP (read replies)
# ---------------------------------------------------------------------------
# The Gmail account that logs in:
GMAIL_USER="you@gmail.com"
# A Google App Password (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# The verified Gmail "Send mail as" alias recipients see:
MAIL_FROM_ADDRESS="a@warlyworks.com"
MAIL_FROM_NAME="Arnav from WarlyWorks"

# Shared secret for the scheduled tick (netlify/functions/tick.mts -> /api/cron/tick).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="replace-with-a-random-string"
